# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://www.guiaviveremalphaville.com.br

# Google Analytics 4 (Consent Mode v2: nada é coletado antes do consentimento)
NEXT_PUBLIC_GA_ID=

# WhatsApp do atendimento Alpha DL, só dígitos com DDI e DDD (opcional: o padrão é o número do site da Alpha DL)
NEXT_PUBLIC_WHATSAPP_ALPHADL=

# Webhook do CRM da Alpha DL que recebe os leads (POST JSON). Sem ele, o formulário avisa que está indisponível.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Portfólio de imóveis da Alpha DL para a vitrine da home (opcional: há um endereço padrão no código)
ALPHADL_FEED_URL=

# 1 = mostra rascunhos (com aviso e noindex). Nunca use em produção.
GUIA_MOSTRAR_RASCUNHOS=
